{
  "permissions": {
    "allow": [
      "Bash(terraform init:*)",
      "Bash(terraform validate:*)",
      "Bash(terraform fmt:*)",
      "Bash(terraform plan:*)",
      "Bash(git add:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(du:*)",
      "Bash(df:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(pytest:*)",
      "Bash(ruff:*)",
      "Bash(make:*)"
    ],
    "deny": [
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(gh pr:*)",
      "Bash(rm -rf:*)",
      "Bash(git add -A)",
      "Bash(git add .)"
    ]
  }
}
