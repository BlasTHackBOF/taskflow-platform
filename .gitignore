__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.coverage
coverage.xml

.env
*.pem
*.key
vault_pass.txt
kubeconfig

**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
# The bootstrap state is deliberately committed: it describes only the
# state bucket itself and contains no secrets (ADR-0006)
!infra/terraform/bootstrap/terraform.tfstate
# Backend config is environment-specific; only the example twin is committed
backend.hcl
!backend.hcl.example

*.db

.DS_Store
.idea/
.vscode/

# Agent / editor local state — shared settings.json is committed on purpose
.claude/settings.local.json

# Secret files — only their .example twins are committed (see ADR-0002)
secrets.yaml

# Ansible
*.retry
inventory/hosts.ini
!inventory/hosts.ini.example

# Helm
charts/*.tgz

# Python
htmlcov/
*.egg-info/
reports/
