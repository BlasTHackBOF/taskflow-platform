# Copy to .env and fill in real values. .env is never committed.
FLASK_ENV=development
SECRET_KEY=change-me-in-every-environment

POSTGRES_DB=taskflow
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=change-me

# Host port is 5433 to avoid colliding with a local PostgreSQL on 5432
DATABASE_URL=postgresql+psycopg2://taskflow:change-me@localhost:5433/taskflow
