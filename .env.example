# Copy to .env and fill in real values. .env is never committed.
#
# docker compose reads this file automatically. The compose stack uses
# SECRET_KEY, POSTGRES_* and the optional APP_PORT / GUNICORN_WORKERS /
# LOG_FORMAT; FLASK_ENV and DATABASE_URL only matter when running the app
# directly on the host.

FLASK_ENV=development
SECRET_KEY=change-me-in-every-environment

# Logging output: json (default, what containers ship) or console (readable)
LOG_FORMAT=console

POSTGRES_DB=taskflow
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=change-me

# Compose: host port the app is published on, and gunicorn worker count
APP_PORT=8000
GUNICORN_WORKERS=2

# Host runs only — the compose stack builds its own DATABASE_URL from the
# POSTGRES_* values above. Host port 5433 avoids a local PostgreSQL on 5432.
DATABASE_URL=postgresql+psycopg2://taskflow:change-me@localhost:5433/taskflow
