# Copy to backend.hcl (gitignored) and fill in the bootstrap outputs.
bucket = "taskflow-prod-tfstate"
key    = "prod/terraform.tfstate"
region = "us-east-1"

# S3-native state locking via conditional writes (Terraform >= 1.10).
# This is what replaces the DynamoDB lock table that is not on this
# project's permitted service list — see ADR-0006.
use_lockfile = true
